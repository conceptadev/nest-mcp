{
  "name": "@nest-mcp/server",
  "version": "0.8.0",
  "description": "NestJS MCP Server - Build Model Context Protocol servers with NestJS",
  "license": "BSD-3-Clause",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map"
  ],
  "keywords": [
    "nestjs",
    "nest",
    "mcp",
    "model-context-protocol",
    "ai",
    "llm",
    "tools",
    "decorators",
    "mcp-server",
    "typescript",
    "anthropic",
    "openai",
    "claude"
  ],
  "homepage": "https://github.com/btwld/nest-mcp#server",
  "repository": {
    "type": "git",
    "url": "https://github.com/btwld/nest-mcp",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@nest-mcp/common": "workspace:*"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0 || 12.0.0-alpha.5",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || 12.0.0-alpha.5",
    "jose": "^5.2.0 || ^6.0.0",
    "reflect-metadata": ">=0.1.13",
    "rxjs": "^7.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "jose": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-fastify": "^11",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.15.43",
    "express": "^4.21.0",
    "jose": "^6.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "typescript": "^5.7.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^2.1.0",
    "zod": "^4.0.0"
  }
}
